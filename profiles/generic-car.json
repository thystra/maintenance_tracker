{
  "schemaVersion": 2,
  "id": "org.argentwolf.maintenance.generic-car",
  "version": "0.2.0",
  "name": "Generic passenger vehicle",
  "category": "vehicle",
  "description": "A conservative starter profile for a passenger vehicle. It intentionally avoids engine, fuel-filter, and propulsion-specific assumptions. Verify every interval against the vehicle manufacturer.",
  "dataLicense": "CC0-1.0",
  "provenance": {
    "author": "Maintenance Tracker contributors",
    "sourceUrl": "https://forgejo.argentwolf.org/alan/maintenance_tracker_for_nextcloud"
  },
  "applicability": {
    "tags": ["car", "vehicle", "generic"]
  },
  "meters": [
    {
      "key": "odometer",
      "name": "Odometer",
      "dimension": "distance",
      "displayUnit": "mi",
      "monotonic": true
    }
  ],
  "components": [
    {
      "key": "tire",
      "name": "Tire",
      "quantity": 4,
      "enabledByDefault": true,
      "notes": "The installer creates one component instance per tire so service history can differ.",
      "compatiblePartKeys": []
    },
    {
      "key": "wiper_blade",
      "name": "Front wiper blade",
      "quantity": 2,
      "enabledByDefault": true,
      "compatiblePartKeys": []
    },
    {
      "key": "cabin_filter",
      "name": "Cabin air filter",
      "quantity": 1,
      "enabledByDefault": false,
      "notes": "Enable only when fitted and use the manufacturer's interval.",
      "compatiblePartKeys": []
    }
  ],
  "parts": [],
  "workGroups": [
    {"key": "tires", "name": "Tires", "sortOrder": 100},
    {"key": "visibility", "name": "Visibility", "sortOrder": 200},
    {"key": "cabin", "name": "Cabin", "sortOrder": 300},
    {"key": "administration", "name": "Administration", "sortOrder": 400}
  ],
  "workDefinitions": [
    {
      "key": "inspect_tires",
      "title": "Inspect tires and pressure",
      "kind": "inspection",
      "groupKey": "tires",
      "componentKey": "tire",
      "enabledByDefault": true,
      "instructions": "Inspect condition, pressure, tread, and visible damage. Use the vehicle manufacturer's pressure specification.",
      "schedule": {"combination": "any", "rules": [{"type": "calendar", "interval": {"value": 1, "unit": "month"}}]},
      "compatiblePartKeys": []
    },
    {
      "key": "rotate_tires",
      "title": "Review tire rotation",
      "kind": "maintenance",
      "groupKey": "tires",
      "componentKey": "tire",
      "enabledByDefault": true,
      "instructions": "Use the pattern and interval specified by the vehicle and tire manufacturers.",
      "schedule": {
        "combination": "any",
        "rules": [
          {"type": "meter", "meterKey": "odometer", "interval": {"value": 7500, "unit": "mi"}},
          {"type": "calendar", "interval": {"value": 12, "unit": "month"}}
        ]
      },
      "compatiblePartKeys": []
    },
    {
      "key": "inspect_wipers",
      "title": "Inspect wiper blades",
      "kind": "inspection",
      "groupKey": "visibility",
      "componentKey": "wiper_blade",
      "enabledByDefault": true,
      "schedule": {"combination": "any", "rules": [{"type": "calendar", "interval": {"value": 6, "unit": "month"}}]},
      "compatiblePartKeys": []
    },
    {
      "key": "registration",
      "title": "Renew registration",
      "kind": "administration",
      "groupKey": "administration",
      "enabledByDefault": true,
      "notes": "Adjust the due date and renewal details for the applicable jurisdiction.",
      "schedule": {"combination": "any", "rules": [{"type": "calendar", "interval": {"value": 1, "unit": "year"}}]},
      "compatiblePartKeys": []
    },
    {
      "key": "replace_cabin_filter",
      "title": "Review cabin air filter replacement",
      "kind": "maintenance",
      "groupKey": "cabin",
      "componentKey": "cabin_filter",
      "enabledByDefault": false,
      "instructions": "Enable only when the vehicle has this component. Replace according to manufacturer guidance and operating conditions.",
      "schedule": {
        "combination": "any",
        "rules": [
          {"type": "calendar", "interval": {"value": 1, "unit": "year"}},
          {"type": "meter", "meterKey": "odometer", "interval": {"value": 15000, "unit": "mi"}}
        ]
      },
      "compatiblePartKeys": []
    },
    {
      "key": "record_unscheduled_repair",
      "title": "Record unscheduled repair",
      "kind": "repair",
      "enabledByDefault": true,
      "schedule": "none",
      "compatiblePartKeys": []
    }
  ]
}
