{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgejo.argentwolf.org/alan/maintenance_tracker_for_nextcloud/src/branch/main/schemas/profile-v2.schema.json",
  "title": "Maintenance Tracker Profile v2",
  "description": "A data-only maintenance template using explicit common work definitions and schedule policies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "category",
    "description",
    "dataLicense",
    "provenance",
    "applicability",
    "meters",
    "components",
    "parts",
    "workGroups",
    "workDefinitions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/key"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "name": {
      "$ref": "#/$defs/displayName"
    },
    "category": {
      "$ref": "#/$defs/shortKey"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "dataLicense": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9.+-]+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "sourceUrl"
      ],
      "properties": {
        "author": {
          "$ref": "#/$defs/displayName"
        },
        "sourceUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manufacturer": {
          "$ref": "#/$defs/optionalDisplayName"
        },
        "model": {
          "$ref": "#/$defs/optionalDisplayName"
        },
        "yearFrom": {
          "$ref": "#/$defs/year"
        },
        "yearTo": {
          "$ref": "#/$defs/year"
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortKey"
          }
        }
      }
    },
    "meters": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/meter"
      }
    },
    "components": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "parts": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "workGroups": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/workGroup"
      }
    },
    "workDefinitions": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/workDefinition"
      }
    }
  },
  "$defs": {
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "optionalDisplayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "shortKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 9999
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "notes": {
      "type": "string",
      "maxLength": 20000
    },
    "meter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "dimension",
        "displayUnit",
        "monotonic"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/shortKey"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "dimension": {
          "enum": [
            "distance",
            "runtime",
            "usage_count"
          ]
        },
        "displayUnit": {
          "enum": [
            "mi",
            "km",
            "m",
            "mm",
            "hour",
            "min",
            "s",
            "use"
          ]
        },
        "monotonic": {
          "type": "boolean"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "quantity",
        "enabledByDefault",
        "compatiblePartKeys"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/shortKey"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "parentKey": {
          "$ref": "#/$defs/shortKey"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "enabledByDefault": {
          "type": "boolean"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "compatiblePartKeys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortKey"
          }
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/displayName"
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "manufacturer",
        "partNumber",
        "description",
        "offers"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/shortKey"
        },
        "manufacturer": {
          "$ref": "#/$defs/displayName"
        },
        "partNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "offers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/offer"
          }
        }
      }
    },
    "workGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "sortOrder"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/shortKey"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "description": {
          "$ref": "#/$defs/notes"
        },
        "sortOrder": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    },
    "calendarScheduleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "interval"
      ],
      "properties": {
        "type": {
          "const": "calendar"
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "unit": {
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            }
          }
        }
      }
    },
    "businessDaysScheduleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "interval",
        "weekdays"
      ],
      "properties": {
        "type": {
          "const": "business_days"
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "unit": {
              "const": "business_day"
            }
          }
        },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sun",
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat"
            ]
          }
        }
      }
    },
    "meterScheduleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "meterKey",
        "interval"
      ],
      "properties": {
        "type": {
          "const": "meter"
        },
        "meterKey": {
          "$ref": "#/$defs/shortKey"
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "oneOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,9})?$"
                }
              ]
            },
            "unit": {
              "enum": [
                "mi",
                "km",
                "m",
                "mm",
                "hour",
                "min",
                "s",
                "use",
                "count"
              ]
            }
          }
        }
      }
    },
    "schedulePolicy": {
      "oneOf": [
        {
          "const": "none"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "combination",
            "rules"
          ],
          "properties": {
            "combination": {
              "const": "any"
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/calendarScheduleRule"
                  },
                  {
                    "$ref": "#/$defs/businessDaysScheduleRule"
                  },
                  {
                    "$ref": "#/$defs/meterScheduleRule"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "workDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "kind",
        "enabledByDefault",
        "schedule",
        "compatiblePartKeys"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/shortKey"
        },
        "title": {
          "$ref": "#/$defs/displayName"
        },
        "kind": {
          "$ref": "#/$defs/shortKey"
        },
        "groupKey": {
          "$ref": "#/$defs/shortKey"
        },
        "componentKey": {
          "$ref": "#/$defs/shortKey"
        },
        "enabledByDefault": {
          "type": "boolean"
        },
        "instructions": {
          "type": "string",
          "maxLength": 10000
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "schedule": {
          "$ref": "#/$defs/schedulePolicy"
        },
        "compatiblePartKeys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortKey"
          }
        }
      }
    }
  }
}
