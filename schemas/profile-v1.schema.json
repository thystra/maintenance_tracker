{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thystra/maintenance_tracker/blob/main/schemas/profile-v1.schema.json",
  "title": "Maintenance Tracker Profile v1",
  "description": "A data-only maintenance template for a class or model of asset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "category",
    "description",
    "dataLicense",
    "provenance",
    "applicability",
    "meters",
    "components",
    "parts",
    "maintenancePlans"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/key"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "name": {
      "$ref": "#/$defs/displayName"
    },
    "category": {
      "$ref": "#/$defs/shortKey"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "dataLicense": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9.+-]+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "sourceUrl"
      ],
      "properties": {
        "author": {
          "$ref": "#/$defs/displayName"
        },
        "sourceUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manufacturer": {
          "$ref": "#/$defs/optionalDisplayName"
        },
        "model": {
          "$ref": "#/$defs/optionalDisplayName"
        },
        "yearFrom": {
          "$ref": "#/$defs/year"
        },
        "yearTo": {
          "$ref": "#/$defs/year"
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortKey"
          }
        }
      }
    },
    "meters": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/meter"
      }
    },
    "components": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "parts": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "maintenancePlans": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/plan"
      }
    }
  },
  "$defs": {
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "optionalDisplayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "shortKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 9999
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "notes": {
      "type": "string",
      "maxLength": 20000
    },
    "meter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "dimension",
        "displayUnit",
        "monotonic"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/shortKey"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "dimension": {
          "enum": [
            "distance",
            "runtime",
            "usage_count"
          ]
        },
        "displayUnit": {
          "enum": [
            "mi",
            "km",
            "hour",
            "use"
          ]
        },
        "monotonic": {
          "type": "boolean"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "quantity",
        "enabledByDefault",
        "compatiblePartKeys"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/shortKey"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "parentKey": {
          "$ref": "#/$defs/shortKey"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "enabledByDefault": {
          "type": "boolean"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "compatiblePartKeys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortKey"
          }
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/displayName"
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "manufacturer",
        "partNumber",
        "description",
        "offers"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/shortKey"
        },
        "manufacturer": {
          "$ref": "#/$defs/displayName"
        },
        "partNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "offers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/offer"
          }
        }
      }
    },
    "calendarTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "interval"
      ],
      "properties": {
        "type": {
          "const": "calendar"
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "unit": {
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            }
          }
        }
      }
    },
    "meterTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "meterKey",
        "interval"
      ],
      "properties": {
        "type": {
          "const": "meter"
        },
        "meterKey": {
          "$ref": "#/$defs/shortKey"
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "unit": {
              "enum": [
                "mi",
                "km",
                "hour",
                "use"
              ]
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "kind",
        "enabledByDefault",
        "combination",
        "triggers",
        "compatiblePartKeys"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/shortKey"
        },
        "title": {
          "$ref": "#/$defs/displayName"
        },
        "kind": {
          "enum": [
            "maintenance",
            "inspection",
            "administration",
            "reorder"
          ]
        },
        "componentKey": {
          "$ref": "#/$defs/shortKey"
        },
        "enabledByDefault": {
          "type": "boolean"
        },
        "combination": {
          "const": "any"
        },
        "instructions": {
          "type": "string",
          "maxLength": 10000
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/calendarTrigger"
              },
              {
                "$ref": "#/$defs/meterTrigger"
              }
            ]
          }
        },
        "compatiblePartKeys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortKey"
          }
        }
      }
    }
  }
}
