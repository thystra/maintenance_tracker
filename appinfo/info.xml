<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>maintenance_tracker</id>
	<name>Maintenance Tracker</name>
	<summary>Track maintenance, usage, service history, and ownership costs</summary>
	<description><![CDATA[
Track recurring maintenance for vehicles, homes, tools, health equipment, and
other assets. Record meter readings, service history, costs, parts, receipts,
and reminders while keeping the data in your Nextcloud.
	]]></description>
	<version>0.1.10</version>
	<licence>AGPL-3.0-or-later</licence>
	<author homepage="https://forgejo.argentwolf.org/alan">Alan Johnson</author>
	<namespace>MaintenanceTracker</namespace>
	<category>organization</category>
	<website>https://forgejo.argentwolf.org/alan/maintenance_tracker_for_nextcloud</website>
	<bugs>https://forgejo.argentwolf.org/alan/maintenance_tracker_for_nextcloud/issues</bugs>
	<repository>https://forgejo.argentwolf.org/alan/maintenance_tracker_for_nextcloud</repository>
	<dependencies>
		<php min-version="8.2" max-version="8.5" min-int-size="64"/>
		<database>pgsql</database>
		<database>mysql</database>
		<database>sqlite</database>
		<lib>zip</lib>
		<nextcloud min-version="33" max-version="35"/>
	</dependencies>
	<background-jobs>
		<job>OCA\MaintenanceTracker\BackgroundJob\ProjectAuditTrail</job>
		<job>OCA\MaintenanceTracker\BackgroundJob\ExpireOwnershipTransfers</job>
		<job>OCA\MaintenanceTracker\BackgroundJob\SendMaintenanceReminders</job>
	</background-jobs>
	<commands>
		<command>OCA\MaintenanceTracker\Command\AssignOwner</command>
		<command>OCA\MaintenanceTracker\Command\ListOrphaned</command>
		<command>OCA\MaintenanceTracker\Command\RunIntegrations</command>
	</commands>
	<settings>
		<admin>OCA\MaintenanceTracker\Settings\AdminSettings</admin>
		<admin-section>OCA\MaintenanceTracker\Settings\AdminSection</admin-section>
	</settings>
	<activity>
		<settings>
			<setting>OCA\MaintenanceTracker\Activity\MaintenanceSetting</setting>
			<setting>OCA\MaintenanceTracker\Activity\EvidenceSetting</setting>
			<setting>OCA\MaintenanceTracker\Activity\MembershipSetting</setting>
			<setting>OCA\MaintenanceTracker\Activity\OwnershipSetting</setting>
		</settings>
		<filters>
			<filter>OCA\MaintenanceTracker\Activity\Filter</filter>
		</filters>
		<providers>
			<provider>OCA\MaintenanceTracker\Activity\Provider</provider>
		</providers>
	</activity>
	<navigations>
		<navigation>
			<id>maintenance_tracker</id>
			<name>Maintenance Tracker</name>
			<route>maintenance_tracker.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
